"""
Scrapling Spider 範本
====================

Copy 到專案後改名 / 改 selector 即可跑。
跑法：
    python my_spider.py
"""
from scrapling.spiders import Spider, Response


class MySpider(Spider):
    # ---------- 基本設定 ----------
    name = "mysite"
    start_urls = [
        "https://example.com/list?page=1",
    ]

    # ---------- 爬取速率 ----------
    concurrent_requests = 8
    download_delay = 1.0           # 秒；對方友善時可 0.5
    autothrottle = True            # 遇 5xx 自動降速

    # ---------- 合規 ----------
    respect_robots_txt = True

    # ---------- 重試 ----------
    retry_times = 3
    retry_http_codes = [429, 500, 502, 503, 504]
    download_timeout = 30

    # ---------- 開發時打開 ----------
    # dev_mode = True              # 第一次跑會 cache 回應，反覆改解析時不重打網站

    async def parse(self, response: Response):
        """列表頁：抓出每個項目 + 翻頁。"""
        for item in response.css(".item"):
            yield response.follow(
                item.css("a.title::attr(href)").get(),
                callback=self.parse_detail,
                meta={"list_title": item.css(".title::text").get()},
            )

        next_url = response.css(".pagination .next::attr(href)").get()
        if next_url:
            yield response.follow(next_url)

    async def parse_detail(self, response: Response):
        """詳細頁：抽欄位。"""
        yield {
            "url": response.url,
            "title": response.css("h1::text").get(),
            "author": response.css(".author::text").get(),
            "published_at": response.css("time::attr(datetime)").get(),
            "content_html": response.css("article .body").get(),
            "content_text": response.css("article .body").get_all_text(),
            "tags": response.css(".tag::text").getall(),
            "list_title": response.meta.get("list_title"),
        }


if __name__ == "__main__":
    result = MySpider(crawldir="./.crawl_mysite").start()
    result.items.to_jsonl("output.jsonl")
    result.items.to_json("output.json")
    print(f"抓完：{len(result.items)} 筆 → output.jsonl / output.json")
